# === 劇本生成（必要，除非使用 --mock） ===
# Claude API 金鑰，用於生成劇本與分鏡腳本。目前沒有長期免費額度，是這條流程裡
# 唯一必須付費的環節，不過用量很小（一次生成一份劇本的成本通常只有幾分錢美金）。
# 取得方式：https://console.anthropic.com
ANTHROPIC_API_KEY=

# ============================================================
# 下面兩組是「免費」的預設 provider，不需要任何金鑰就能用：
#   --video-provider kenburns（預設）：免費文生圖 + ffmpeg Ken Burns 動態效果
#   --voice-provider edge（預設）：借用 Microsoft Edge 線上朗讀引擎
# 這兩個都是公開、不需認證的免費服務，穩定性與畫質／音質不保證跟付費服務同等級，
# 而且某些網路環境（尤其是雲端主機／資料中心）可能連不上或被暫時擋掉。
# 如果被擋，改用下面的付費 provider，或先用 --mock 測試其餘流程。
# ============================================================

# 免費文生圖（Pollinations.ai，不需要金鑰）
POLLINATIONS_MODEL=flux
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920

# 免費配音（edge-tts，不需要金鑰）。語音清單可執行：
#   npx tsx -e "import('msedge-tts').then(async ({MsEdgeTTS})=>console.log(await new MsEdgeTTS().getVoices()))"
# 常用中文語音：zh-TW-HsiaoChenNeural（台灣女聲）、zh-TW-YunJheNeural（台灣男聲）、
#              zh-CN-XiaoxiaoNeural（中國大陸女聲）
EDGE_TTS_VOICE=zh-TW-HsiaoChenNeural

# ============================================================
# 下面是付費的替代 provider，用 --video-provider runway / seedance、
# --voice-provider elevenlabs 啟用
# ============================================================

# Runway ML API 金鑰（--video-provider runway 時需要）。取得方式：https://dev.runwayml.com
# 注意：Runway 的 API 端點／欄位名稱可能隨版本更新而變動，
# 若遇到 404 或欄位錯誤，請對照 https://docs.dev.runwayml.com 更新下列設定。
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
RUNWAY_VIDEO_MODEL=gen4_turbo
RUNWAY_IMAGE_MODEL=gen4_image

# fal.ai 金鑰（--video-provider seedance 時需要）—— ByteDance Seedance 2.0，透過
# fal.ai 存取。取得方式：https://fal.ai（Dashboard → Keys）
# 注意：這是照 fal.ai 公開文件實作的，若遇到 404 或欄位錯誤，請對照
# https://fal.ai/models/bytedance/seedance-2.0 與 https://docs.fal.ai/model-apis/queue
# 確認目前的端點路徑與請求格式。
FAL_KEY=
FAL_API_BASE_URL=https://queue.fal.run
SEEDANCE_MODEL=bytedance/seedance-2.0/text-to-video
SEEDANCE_RESOLUTION=720p

# ElevenLabs API 金鑰（--voice-provider elevenlabs 時需要）。取得方式：https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === 可選：覆寫本機 ffmpeg / ffprobe 執行檔路徑 ===
# 預設會使用 ffmpeg-static / ffprobe-static 自帶的二進位檔，通常不需要設定。
# FFMPEG_PATH=
# FFPROBE_PATH=
